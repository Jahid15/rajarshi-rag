# Pick one LLM provider: gemini, groq or anthropic
LLM_PROVIDER=gemini
# Optional, leave empty for the default model of the provider
LLM_MODEL=

GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval settings (defaults shown)
EMBED_MODEL=BAAI/bge-m3
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K=8
WINDOW=2
MIN_SCORE=0.45
